{
  "name": "search-agent",
  "version": "0.2.36",
  "description": "内置浏览器 + 页面信息采集 Agent",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node audit-fixes-test.js && node api-format-test.js && npm run test:desktop",
    "dist": "electron-builder",
    "bundle": "node bundle/make-bundle.js",
    "ship": "npm run dist && npm run bundle",
    "test:documents": "node document-files-test.js",
    "test:desktop": "node scripts/run-electron-tests.js"
  },
  "keywords": [
    "browser",
    "electron",
    "agent"
  ],
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.searchagent.desktop",
    "productName": "Search Agent",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Search Agent",
      "artifactName": "Search Agent Setup.exe"
    },
    "portable": {
      "artifactName": "Search Agent.exe"
    }
  },
  "devDependencies": {
    "electron": "^37.3.1",
    "electron-builder": "^26.15.3"
  }
}
